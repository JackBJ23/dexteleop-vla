-                    self._uri, compression=None, max_size=None, additional_headers=headers
+                    self._uri, compression=None, max_size=None, additional_headers=headers,
+                    # disable keepalive pings: the FIRST inference triggers a long JAX/cuDNN compile
+                    # (>20s) during which no pong is sent, which would otherwise drop the connection
+                    # ("keepalive ping timeout"). Inference is request/response, so pings aren't needed.
+                    ping_interval=None,
                 )
                 metadata = msgpack_numpy.unpackb(conn.recv())
                 return conn, metadata
